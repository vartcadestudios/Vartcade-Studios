  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'You have ten days before sundown, and only two ways to make it out alive:
    claim a seat in the Bunker, or hoard enough Real Supply cards to survive on your
    own. The catch is that every card in your hand looks the same face-down. Real
    Supply, worthless Trash, and the one Bunker Key are all mixed together, so you
    never know what you''re really holding. Each day is split into two halves. In
    the Day phase, you take a single action with your eyes open: trade cards with
    another player, scavenge from the shared pool, or play a Morning Action Card
    to shake up the table. When night falls, everyone closes their eyes and gets
    two actions: first peek at one of your own cards, then steal from someone, swap
    with someone, skip, or play a Night Action Card.



    From Day 6 onward, the
    Rondo starts to spin. Each day it lands on a calamity that can purge cards from
    the deck, strip food supplies from every player, scramble everyone''s hands,
    force you to play blind in daylight, or even cut a day off the countdown, so
    the clock can run out faster than you planned. Once Day 10 arrives, only two
    kinds of players survive: whoever holds the Bunker Key (who may bring exactly
    one other person inside), and anyone carrying enough Real Supply to last on their
    own. Everyone else is left outside. Guard your best cards, watch your rivals,
    and remember: trust no one.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
